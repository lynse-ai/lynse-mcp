LYNSE_MCP_PUBLIC_URL=https://www.lynse.cn/mcp
LYNSE_WEB_ORIGIN=https://www.lynse.cn
LYNSE_ACCOUNT_API_ORIGIN=https://api.lynse.cn
LYNSE_MCP_DATABASE=/data/oauth.sqlite3
# Generate once using the command in docs/ACCOUNT_OAUTH.md. Keep it when restarting.
LYNSE_MCP_ENCRYPTION_KEY=
# Optional: enable only after configuring this domain in the WeChat platform.
LYNSE_WECHAT_CALLBACK_URL=
LYNSE_WECHAT_AUTH_TYPE=WECHAT_JUMP
# Desktop deep links allowed during client registration; HTTPS and loopback always work.
LYNSE_MCP_REDIRECT_SCHEMES=workbuddy,cursor,vscode
# Optional browser test client; enable only on a test instance.
LYNSE_MCP_TEST_UI=0
# Additional HTTPS media origins allowed in MCP Apps audio components (comma-separated).
# Default allowlist covers *.lynse.cn, *.lynse.ai and *.aliyuncs.com.
LYNSE_MCP_MEDIA_ORIGINS=
