FROM python:3.12-slim AS dependencies
WORKDIR /build
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
COPY requirements.txt requirements-mcp.txt requirements-remote.txt ./
COPY vendor/lynse_cli-1.7.0-py3-none-any.whl vendor/
# Use the wheel built from the official v1.7.0 tag; no Git/apt access on ECS.
RUN python -c "from pathlib import Path; p=Path('requirements.txt'); old='lynse-cli @ git+https://github.com/lynse-ai/lynse-cli.git@v1.7.0'; text=p.read_text(); assert text.count(old)==1; p.write_text(text.replace(old, './vendor/lynse_cli-1.7.0-py3-none-any.whl'))" \
    && python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements-remote.txt

FROM python:3.12-slim AS production
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /app
COPY --from=dependencies /opt/venv /opt/venv
RUN useradd --uid 10001 --create-home mcp \
    && mkdir /data && chown mcp:mcp /data
COPY lynse_mcp.py lynse_auth.py lynse_remote.py lynse_account.py lynse_oauth_store.py ./
USER mcp
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
CMD ["python", "lynse_remote.py", "--host", "0.0.0.0", "--port", "8000"]
