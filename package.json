{
  "name": "@lynse.ai/lynse-mcp",
  "version": "0.1.0",
  "description": "灵光记 Lynse 的独立 MCP 服务仓库，提供会议、音频、文件夹和待办的 Model Context Protocol 接口。",
  "main": "lynse_mcp.py",
  "bin": {
    "lynse-mcp": "./bin/lynse-mcp.js"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v",
    "build:ui": "node web/build.mjs",
    "check:ui": "tsc --noEmit -p web/tsconfig.json",
    "test:ui": "playwright test -c web/playwright.config.ts",
    "preview:ui": "python3 scripts/preview_apps.py"
  },
  "keywords": [
    "lynse",
    "mcp",
    "model-context-protocol",
    "meetings",
    "todos",
    "folders",
    "ai"
  ],
  "author": "lynse.ai",
  "license": "MIT",
  "homepage": "https://www.lynse.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynse-ai/lynse-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/lynse-ai/lynse-mcp/issues"
  },
  "files": [
    "lynse_auth.py",
    "lynse_mcp.py",
    "lynse_ui.py",
    "web/dist/lynse-app.html",
    "bin/lynse-mcp.js",
    "requirements.txt",
    "requirements-mcp.txt",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "python": ">=3.11"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.2.1",
    "esbuild": "^0.28.1",
    "lucide": "^0.577.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.0"
  }
}
